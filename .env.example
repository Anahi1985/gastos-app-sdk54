# Copiá este archivo como .env y definí la URL base del servidor.
# No incluyas /gastos al final: la app lo agrega automáticamente.
#
# Android emulador:
EXPO_PUBLIC_API_URL=http://10.0.2.2:3002
#
# iOS / web:
# EXPO_PUBLIC_API_URL=http://localhost:3002
#
# Dispositivo físico (misma red que la PC):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3002
